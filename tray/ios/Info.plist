<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key><string>Bento Tray</string>
  <!-- Must be present and must reference the build setting: without it the app
       has no bundle id and `simctl install` refuses it ("Missing bundle ID"). -->
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
  <key>CFBundleShortVersionString</key><string>1.0.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>LSSupportsOpeningDocumentsInPlace</key><true/>
  <key>UISupportsDocumentBrowser</key><true/>
  <key>UIFileSharingEnabled</key><true/>
  <!--
    The launch screen. An empty dict here meant a plain system-white screen, so
    the app flashed white and then the document appeared — the one moment the app
    is guaranteed to be seen, spent saying nothing.

    Navy ground plus the mark, both named from Assets.xcassets so they are the
    same values the icon is drawn from (generated by tray/assets/make-icons.mjs).
    The mark carries its own navy ground, which melts into the background here and
    leaves the cream tray floating — the same silhouette as the app icon the user
    just tapped, which is the whole point of a launch screen.

    Note it is NOT a loading indicator: iOS renders this static, before any code
    runs, so nothing here can show progress. It exists to make the launch feel
    like the app rather than like a blank page.
  -->
  <key>UILaunchScreen</key>
  <dict>
    <key>UIColorName</key><string>BentoNavy</string>
    <key>UIImageName</key><string>BentoMark</string>
    <key>UIImageRespectsSafeAreaInsets</key><false/>
  </dict>
  <!--
    Light status bar over the navy launch ground. Without this the clock and
    battery render as dark content on a dark background and are nearly invisible
    for the length of the launch — measured on the first build of this screen.

    This key styles the LAUNCH only. `UIViewControllerBasedStatusBarAppearance`
    stays at its default of true, so once the app is up each view controller
    answers for itself again — which matters, because the editor hides the bar
    entirely on iPad and must keep that say.
  -->
  <key>UIStatusBarStyle</key><string>UIStatusBarStyleLightContent</string>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>Bento document</string>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array><string>public.html</string></array>
    </dict>
  </array>
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key><true/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array><dict>
        <key>UISceneConfigurationName</key><string>Default</string>
        <key>UISceneDelegateClassName</key><string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
      </dict></array>
    </dict>
  </dict>
</dict>
</plist>
